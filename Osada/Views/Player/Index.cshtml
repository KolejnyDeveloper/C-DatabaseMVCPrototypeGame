@model IEnumerable<Osada.Models.Village>

@{
    ViewData["Title"] = "Moja osada";
}

<div class="container mt-4">
    <h1>Witaj w Osadzie, @User.Identity?.Name!</h1>

    <p class="text-muted">
        Panel zarządzania Twoimi wioskami.
    </p>

    <hr />

    <h3>Moje wioski</h3>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h5>𓆿𓆿 Puste pola 𓆿𓆿</h5>

            <p>
                Pora na pierwszą osade
            </p>

            <a asp-controller="Player"
               asp-action="CreateVillage"
               class="btn btn-success">
                𓂀 Zbuduj pierwszą osade
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var village in Model)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">
                                @village.Name
                            </h5>

                            <p>
                                Punkty: @village.Points
                            </p>

                            <p>
                                Koordy:
                                (@village.X, @village.Y)
                            </p>

                            <span class="badge bg-success">
                                Osada
                            </span>

                            <div class="mt-3">
                                <a asp-controller="Player"
                                   asp-action="Village"
                                   asp-route-id="@village.VillageId"
                                   class="btn btn-primary w-100">
                                    Panel Osady
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            }
        </div>
    }
</div>
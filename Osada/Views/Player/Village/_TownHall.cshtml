@model Osada.Models.ViewModels.VillageDashboardViewModel

<h1>𓉪 Ratusz</h1>

<p class="section-description">
    Przegląd osady
</p>

<hr />

<h3>Zasoby wioski</h3>

<div class="row g-3">

    <div class="col-md-6 col-xl-3">
        <div class="resource-card">
            <h5>𓆱 Drewno</h5>
            <h3>@Model.WoodAmount</h3>
            <span>+@Model.WoodProduction / godzinę</span>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="resource-card">
            <h5>𓈑 Glina</h5>
            <h3>@Model.ClayAmount</h3>
            <span>+@Model.ClayProduction / godzinę</span>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="resource-card">
            <h5>𓈔 Żelazo</h5>
            <h3>@Model.IronAmount</h3>
            <span>+@Model.IronProduction / godzinę</span>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="resource-card">
            <h5>𓇣 Żywność</h5>
            <h3>@Model.FoodAmount</h3>
            <span>+@Model.FoodProduction / godzinę</span>
        </div>
    </div>

</div>

<h3 class="section-heading">Budynki wioski</h3>

@if (Model.Buildings == null || !Model.Buildings.Any())
{
    <div class="alert alert-info">
        Nic tu nie ma
    </div>
}
else
{
    <div class="row g-3">

        @foreach (var building in Model.Buildings)
        {
            <div class="col-md-6 col-lg-4">
                <div class="building-card">
                    <h5>@building.Name</h5>

                    <span class="badge bg-secondary">
                        Poziom @building.Level
                    </span>
                </div>
            </div>
        }

    </div>
}
